<%- include('partials/head', { title: q ? `Søk: ${q} — food.st44.no` : 'food.st44.no — familiens oppskrifter' }) %>
<%- include('partials/mast', { nav: 'list', home: true, q }) %>
<main id="main" tabindex="-1">
  <%- include('partials/flash', { flash }) %>

  <% if (state === 'empty') { %>
    <div class="wrap">
      <div class="notice">
        <div class="notice__rule"></div>
        <h2>Ingen oppskrifter ennå</h2>
        <p>Legg inn den første, så finner dere den igjen her.</p>
        <div class="notice__actions">
          <a class="btn btn--primary btn--lg" href="/recipes/new">Legg til den første oppskriften</a>
        </div>
      </div>
    </div>

  <% } else if (state === 'error') { %>
    <div class="wrap">
      <div class="alert" role="alert">
        <p class="alert__title">Kunne ikke hente oppskriftene.</p>
        <p>Prøv igjen om litt.</p>
        <a class="btn" href="/<%= searchQuery %>">Prøv på nytt</a>
      </div>
    </div>

  <% } else if (state === 'no-hits') { %>
    <div class="wrap">
      <div class="notice">
        <div class="notice__rule"></div>
        <h2>Ingen treff på «<%= q %>»</h2>
        <p>Prøv et kortere søk, eller se alle oppskriftene.</p>
        <div class="notice__actions">
          <a class="btn btn--lg" href="/">Vis alle oppskrifter</a>
        </div>
      </div>
    </div>

  <% } else if (q) { %>
    <%# A search answers with a register of hits — no lead dish, nothing chosen for you. %>
    <section class="results">
      <div class="wrap">
        <h2 class="visually-hidden">Søkeresultater</h2>
        <div class="results__head">
          <p class="result-count" role="status"><%= count %></p>
          <p class="clear"><a href="/">Tøm søk</a></p>
        </div>
        <ul class="hits">
          <% recipes.forEach(function (recipe) { %>
            <li>
              <a class="sideitem" href="/recipes/<%= recipe.id %><%= searchQuery %>">
                <% if (recipe.photo) { %>
                  <img src="<%= recipe.photo %>" alt="">
                <% } else { %>
                  <span class="plate plate--thumb"></span>
                <% } %>
                <div>
                  <h3><%= recipe.title %></h3>
                  <p class="m"><%= recipe.meta %></p>
                </div>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
    </section>

  <% } else { %>
    <%# The unsearched front page: one dish large, the archive beside it. %>
    <section class="lead">
      <div class="wrap grid">
        <figure class="lead__fig">
          <% if (front.lead.photo) { %>
            <img src="<%= front.lead.photo %>" alt="">
          <% } else { %>
            <span class="plate"></span>
          <% } %>
          <figcaption class="lead__plate">
            <p class="kicker">Sist lagt inn</p>
            <h2><a href="/recipes/<%= front.lead.id %>"><%= front.lead.title %></a></h2>
            <p class="lead__dek"><%= front.lead.ingredientCount %>
              <%= front.lead.ingredientCount === 1 ? 'ingrediens' : 'ingredienser' %><% if (front.lead.added) { %>,
              lagt inn <%= front.lead.added %><% } %>.</p>
          </figcaption>
        </figure>

        <div class="lead__side">
          <% if (front.side.length) { %>
            <div class="band">
              <h2 class="band__head">Nylig lagt inn</h2>
              <p class="band__sub"><%= front.sideSub %></p>
              <% front.side.forEach(function (recipe) { %>
                <a class="sideitem" href="/recipes/<%= recipe.id %>">
                  <% if (recipe.photo) { %>
                    <img src="<%= recipe.photo %>" alt="">
                  <% } else { %>
                    <span class="plate plate--thumb"></span>
                  <% } %>
                  <div>
                    <h3><%= recipe.title %></h3>
                    <p class="m"><%= recipe.meta %></p>
                  </div>
                </a>
              <% }); %>
            </div>
          <% } %>

          <div class="band index<%= front.side.length ? '' : ' index--first' %>">
            <h2 class="band__head">Hele samlingen</h2>
            <p class="band__sub"><%= recipes.length === 1
              ? 'Den ene oppskriften i samlingen.'
              : `Alle ${recipes.length} oppskriftene, i alfabetisk rekkefølge.` %></p>
            <ol>
              <% front.index.forEach(function (recipe) { %>
                <li>
                  <a href="/recipes/<%= recipe.id %>"><%= recipe.title %></a>
                  <span class="d"></span>
                  <span class="t"><%= recipe.date %></span>
                </li>
              <% }); %>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <% if (front.rest.length) { %>
      <section class="more">
        <div class="wrap">
          <div class="more__head">
            <h2>Resten av samlingen</h2>
            <p>Eldre oppskrifter, nyest først.</p>
          </div>
          <div class="cards" style="--cols:<%= Math.min(front.rest.length, 4) %>">
            <% front.rest.forEach(function (recipe) { %>
              <a class="card" href="/recipes/<%= recipe.id %>">
                <% if (recipe.photo) { %>
                  <img src="<%= recipe.photo %>" alt="">
                <% } else { %>
                  <span class="plate"></span>
                <% } %>
                <h3><%= recipe.title %></h3>
                <p class="m"><%= recipe.meta %></p>
              </a>
            <% }); %>
          </div>
        </div>
      </section>
    <% } %>
  <% } %>
</main>
<%- include('partials/foot') %>
