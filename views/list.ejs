<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Oppskrifter — food.st44.no</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <a class="skip-link visually-hidden-focusable" href="#main">Hopp til innhold</a>
  <header class="app-header">
    <h1>Oppskrifter</h1>
    <% if (state !== 'empty') { %>
      <a class="btn btn--primary" href="/recipes/new">+ Ny oppskrift</a>
    <% } %>
  </header>
  <main id="main" tabindex="-1">
    <%- include('partials/flash', { flash }) %>
    <% if (state === 'empty') { %>
      <div class="empty-state">
        <h2 class="empty-state__title">Ingen oppskrifter ennå</h2>
        <p class="empty-state__body">Legg inn den første, så finner dere den igjen her.</p>
        <a class="btn btn--primary" href="/recipes/new">+ Legg til den første oppskriften</a>
      </div>
    <% } else { %>
      <div class="list-controls">
        <form class="search" method="get" action="/" role="search">
          <label class="visually-hidden" for="q">Søk etter oppskrift</label>
          <input class="search-field" type="search" id="q" name="q"
                 placeholder="Søk etter oppskrift" value="<%= q %>">
          <button class="visually-hidden-focusable" type="submit">Søk</button>
        </form>
        <% if (state === 'list') { %>
          <p class="result-count" role="status"><%= count %><% if (q) { %> — <a href="/">Tøm søk</a><% } %></p>
        <% } %>
      </div>

      <% if (state === 'error') { %>
        <div class="alert alert--error" role="alert">
          <span aria-hidden="true">⚠</span>
          <div>
            <p class="alert__title">Kunne ikke hente oppskriftene.</p>
            <p>Prøv igjen om litt.</p>
            <a class="btn btn--secondary" href="/<%= searchQuery %>">Prøv på nytt</a>
          </div>
        </div>
      <% } else if (state === 'no-hits') { %>
        <div class="empty-state">
          <h2 class="empty-state__title">Ingen treff på «<%= q %>»</h2>
          <p class="empty-state__body">Prøv et kortere søk, eller se alle oppskriftene.</p>
          <a class="btn btn--secondary" href="/">Vis alle oppskrifter</a>
        </div>
      <% } else { %>
        <ul class="recipe-list">
          <% recipes.forEach(function (recipe) { %>
            <li>
              <a class="recipe-card" href="/recipes/<%= recipe.id %><%= searchQuery %>">
                <h2 class="recipe-card__title"><%= recipe.title %></h2>
                <p class="recipe-card__meta"><%= recipe.meta %></p>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    <% } %>
  </main>
  <% if (state !== 'empty') { %>
    <div class="action-bar">
      <a class="btn btn--primary btn--block" href="/recipes/new">+ Ny oppskrift</a>
    </div>
  <% } %>
</body>
</html>
