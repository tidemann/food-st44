<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Oppskrifter — food.st44.no</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <h1>Oppskrifter</h1>
  </header>
  <main>
    <%- include('partials/flash', { flash }) %>
    <form class="search" method="get" action="/">
      <label for="q">Søk etter navn</label>
      <input type="search" id="q" name="q" value="<%= q %>">
      <button type="submit">Søk</button>
    </form>
    <% if (recipes.length === 0) { %>
      <p class="empty-state"><%= q ? 'Ingen oppskrifter passer søket.' : 'Ingen oppskrifter ennå.' %></p>
    <% } else { %>
      <ul class="recipe-list">
        <% recipes.forEach(function (recipe) { %>
          <li class="recipe-list__item">
            <h2 class="recipe-title"><a href="/recipes/<%= recipe.id %>"><%= recipe.title %></a></h2>
            <section class="recipe-section">
              <h3>Ingredienser</h3>
              <pre class="recipe-ingredients"><%= recipe.ingredients %></pre>
            </section>
            <section class="recipe-section">
              <h3>Fremgangsmåte</h3>
              <pre class="recipe-instructions"><%= recipe.instructions %></pre>
            </section>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </main>
</body>
</html>
