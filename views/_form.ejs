<%#
  Shared recipe form for new and edit (wireframes S6/S7/S8). One template, two modes.
  Locals: mode ('new' | 'edit'), action, cancelHref, values, errors.
%>
<% const submitLabel = mode === 'edit' ? 'Lagre endringer' : 'Lagre oppskrift'; %>
<form action="<%= action %>" method="post" class="recipe-form">
  <% if (errors.title || errors.ingredients) { %>
    <div class="alert alert--error" id="error-summary" role="alert" tabindex="-1" autofocus>
      <div>
        <p class="alert__title"><span aria-hidden="true">⚠</span> Oppskriften ble ikke lagret</p>
        <ul>
          <% if (errors.title) { %><li><a href="#title"><%= errors.title %></a></li><% } %>
          <% if (errors.ingredients) { %><li><a href="#ingredients"><%= errors.ingredients %></a></li><% } %>
        </ul>
      </div>
    </div>
  <% } %>

  <div class="field<%= errors.title ? ' field--error' : '' %>">
    <label for="title">Tittel</label>
    <input type="text" id="title" name="title" value="<%= values.title || '' %>"
      <% if (errors.title) { %>aria-invalid="true" aria-describedby="title-error"<% } %>>
    <% if (errors.title) { %>
      <p class="field__error" id="title-error"><span aria-hidden="true">⚠</span> <%= errors.title %></p>
    <% } %>
  </div>

  <div class="field<%= errors.ingredients ? ' field--error' : '' %>">
    <label for="ingredients">Ingredienser</label>
    <p class="field__hint" id="ingredients-hint">Én ingrediens per linje.</p>
    <textarea id="ingredients" name="ingredients" rows="8"
      aria-describedby="ingredients-hint<%= errors.ingredients ? ' ingredients-error' : '' %>"
      <% if (errors.ingredients) { %>aria-invalid="true"<% } %>><%= values.ingredients || '' %></textarea>
    <% if (errors.ingredients) { %>
      <p class="field__error" id="ingredients-error"><span aria-hidden="true">⚠</span> <%= errors.ingredients %></p>
    <% } %>
  </div>

  <div class="field">
    <label for="instructions">Fremgangsmåte (valgfritt)</label>
    <textarea id="instructions" name="instructions" rows="10"><%= values.instructions || '' %></textarea>
  </div>

  <div class="form-actions">
    <button class="btn btn--primary" type="submit"><%= submitLabel %></button>
    <a class="btn btn--secondary" href="<%= cancelHref %>">Avbryt</a>
  </div>
</form>
<script>
  // S12: progressive enhancement only — the 303 redirect already prevents duplicates without JS.
  (function (form, button) {
    form.addEventListener('submit', function () { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Lagrer…'; });
    window.addEventListener('pageshow', function () { button.disabled = false; button.removeAttribute('aria-busy'); button.textContent = '<%= submitLabel %>'; });
  })(document.querySelector('.recipe-form'), document.querySelector('.recipe-form button[type="submit"]'));
</script>
