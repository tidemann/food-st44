<%- include('partials/head', { title: `Slett «${recipe.title}»? — food.st44.no` }) %>
<%- include('partials/mast', { nav: '', home: false }) %>
<main id="main" tabindex="-1">
  <div class="wrap">
    <div class="notice">
      <div class="notice__rule"></div>
      <h1>Slett «<%= recipe.title %>»?</h1>
      <p>Oppskriften blir borte for godt. Dette kan ikke angres.</p>
      <form action="/recipes/<%= recipe.id %>/delete" method="POST" class="notice__actions">
        <a class="btn btn--lg" href="/recipes/<%= recipe.id %><%= searchQuery %>">Avbryt</a>
        <button class="btn btn--danger btn--lg" type="submit">Slett oppskriften</button>
      </form>
    </div>
  </div>
</main>
<%- include('partials/foot') %>
