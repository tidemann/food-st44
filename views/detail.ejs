<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= recipe.title %> — food.st44.no</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <h1><%= recipe.title %></h1>
  </header>
  <main>
    <section class="recipe-section">
      <h2>Ingredienser</h2>
      <pre class="recipe-ingredients"><%= recipe.ingredients %></pre>
    </section>
    <section class="recipe-section">
      <h2>Fremgangsmåte</h2>
      <pre class="recipe-instructions"><%= recipe.instructions %></pre>
    </section>
    <p><a href="/">← Tilbake til oppskrifter</a></p>
  </main>
</body>
</html>
