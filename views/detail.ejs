<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= recipe.title %> — food.st44.no</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <a class="skip-link visually-hidden-focusable" href="#main">Hopp til innhold</a>
  <header class="app-header">
    <h1><%= recipe.title %></h1>
  </header>
  <main id="main" tabindex="-1">
    <%- include('partials/flash', { flash }) %>
    <section class="recipe-section">
      <h2>Ingredienser</h2>
      <p class="recipe-body recipe-ingredients"><%= recipe.ingredients %></p>
    </section>
    <section class="recipe-section">
      <h2>Fremgangsmåte</h2>
      <p class="recipe-body recipe-instructions"><%= recipe.instructions %></p>
    </section>
    <form action="/recipes/<%= recipe.id %>/delete" method="POST" class="delete-form">
      <button type="submit">Slett oppskrift</button>
    </form>
    <p><a href="/">← Tilbake til oppskrifter</a></p>
  </main>
</body>
</html>
