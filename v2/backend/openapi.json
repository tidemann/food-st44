            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        },
        "description": "Read by the same provider as photos when reading is on (`read_by: ai`, counted like a photo read). When reading is off or the provider fails, the text is split by simple rules instead (`read_by: rules`) and `notice` says why. 200 with `readable: false` when no recipe was found.",
        "tags": [
          "recipes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextImportIn"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "EditorAuth": []
          }
        ]
      }
    },
