    "/api/recipes/import-link": {
      "post": {
        "operationId": "import_recipe_link",
        "summary": "Read the schema.org recipe on a web page into a draft; saves nothing",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeDraftOut"
