    "/api/recipes/import-text": {
      "post": {
        "operationId": "import_recipe_text",
        "summary": "Read a recipe pasted as plain text into a draft; saves nothing",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextDraftOut"
