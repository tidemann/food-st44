  "components": {
    "schemas": {
      "MeOut": {
        "properties": {
          "signed_in": {
            "title": "Signed In",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "initial": {
            "title": "Initial",
            "type": "string"
          },
          "is_editor": {
            "title": "Is Editor",
            "type": "boolean"
          },
          "sign_in_available": {
            "title": "Sign In Available",
            "type": "boolean"
          }
        },
        "required": [
          "signed_in",
          "name",
          "initial",
          "is_editor",
          "sign_in_available"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "RecipeOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "instructions": {
            "title": "Instructions",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "ingredients": {
            "title": "Ingredients",
            "type": "string"
          }
        },
        "required": [
          "id",
          "instructions",
          "created_at",
          "photo_url",
          "tags",
          "title",
          "ingredients"
        ],
        "title": "RecipeOut",
        "type": "object"
      },
      "ValidationErrors": {
        "description": "422 body: one message per field, keyed by field name, ready to show next to the input.",
        "properties": {
          "errors": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Errors",
            "type": "object"
          }
        },
        "required": [
          "errors"
        ],
        "title": "ValidationErrors",
        "type": "object"
      },
      "RecipeIn": {
        "description": "Create and edit share one rule set (inventory §3.2). Values are stored trimmed.",
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "ingredients": {
            "title": "Ingredients",
            "type": "string"
          },
          "instructions": {
            "default": "",
            "title": "Instructions",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "title",
          "ingredients"
        ],
        "title": "RecipeIn",
        "type": "object"
      },
      "PhotoReadingOut": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ],
        "title": "PhotoReadingOut",
        "type": "object"
      },
      "RecipeDraftOut": {
        "description": "A recipe read from a photo, a link or pasted text, for the \"Ny oppskrift\" form to fill\nin. Nothing is saved: the editor checks it and saves it with POST /api/recipes like any\nother.",
        "properties": {
          "readable": {
            "title": "Readable",
            "type": "boolean"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "ingredients": {
            "title": "Ingredients",
            "type": "string"
          },
          "instructions": {
            "title": "Instructions",
            "type": "string"
          }
        },
        "required": [
          "readable",
          "title",
          "ingredients",
          "instructions"
        ],
        "title": "RecipeDraftOut",
        "type": "object"
      },
      "LinkImportIn": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "LinkImportIn",
        "type": "object"
      },
      "TextDraftOut": {
        "description": "The draft from pasted text: read by the AI provider when reading is on, else split by\nsimple rules (food.importer.split_text), and the form says which.",
        "properties": {
          "readable": {
            "title": "Readable",
            "type": "boolean"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "ingredients": {
            "title": "Ingredients",
            "type": "string"
          },
          "instructions": {
            "title": "Instructions",
            "type": "string"
          },
          "read_by": {
            "enum": [
              "ai",
              "rules"
            ],
            "title": "Read By",
            "type": "string"
          },
          "notice": {
            "title": "Notice",
            "type": "string"
          }
        },
        "required": [
          "readable",
          "title",
          "ingredients",
          "instructions",
          "read_by",
          "notice"
        ],
        "title": "TextDraftOut",
