from django.http import HttpRequest, HttpResponse
from django.views import View
from oauth2_provider.forms import AllowForm

class AuthorizationView(View):
    request: HttpRequest
    def render_to_response(self, context: dict[str, object], **kwargs: object) -> HttpResponse: ...
    def form_valid(self, form: AllowForm) -> HttpResponse: ...

class TokenView(View): ...
class RevokeTokenView(View): ...
class OAuthServerMetadataView(View): ...
class OAuthProtectedResourceMetadataView(View): ...

class DynamicClientRegistrationView(View):
    def post(self, request: HttpRequest, *args: object, **kwargs: object) -> HttpResponse: ...

class DynamicClientRegistrationManagementView(View): ...
